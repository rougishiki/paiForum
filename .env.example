# GitHub OAuth 配置
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8080/oauth/github/callback

# 微信公众号配置
WX_APP_ID=your_wechat_app_id_here
WX_APP_SECRET=your_wechat_app_secret_here

# 知识星球配置
ZSXQ_APP_ID=your_zsxq_app_id_here
ZSXQ_GROUP_NUMBER=your_zsxq_group_number_here
ZSXQ_SECRET=your_zsxq_secret_here

# 数据库配置（如果需要）
# DB_URL=jdbc:mysql://localhost:3306/pai_coding
# DB_USERNAME=root
# DB_PASSWORD=your_password_here

# Redis 配置（如果需要）
# REDIS_HOST=localhost
# REDIS_PORT=6379
